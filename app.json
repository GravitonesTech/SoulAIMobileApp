{
  "expo": {
    "name": "Soul AI",
    "slug": "soulai",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "soulai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/icon.png",
      "buildNumber": "14",
      "supportsTablet": true,
      "bundleIdentifier": "com.soulai.in",
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone.",
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera to take photos.",
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photo library to select photos.",
        "NSCalendarsUsageDescription": "Allow $(PRODUCT_NAME) to access your calendar to add and schedule meetings.",
        "NSContactsUsageDescription": "Allow $(PRODUCT_NAME) to access your contacts to easily invite them to meetings.",
        "UIBackgroundModes": ["remote-notification"],
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "phonepe",
          "tez",
          "paytmmp",
          "bhim",
          "credpay",
          "whatsapp",
          "gpay"
        ]
      }
    },
    "android": {
      "versionCode": 17,
      "package": "com.soulai.in",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#4698ea",
        "foregroundImage": "./assets/images/adaptive_foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#4698ea"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28,
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.zipow.** { *; }\n-keep class us.zoom.** { *; }\n-keep class com.zoom.** { *; }\n-keep class org.webrtc.** { *; }\n-dontwarn org.webrtc.**\n-dontwarn com.zipow.**\n-dontwarn us.zoom.**\n-keep class com.razorpay.** { *; }\n-dontwarn com.razorpay.**\n-dontwarn com.google.zxing.Result\n-dontwarn java.awt.event.ActionListener\n-dontwarn javax.swing.SwingUtilities\n-dontwarn javax.swing.Timer",
            "extraGradleProperties": {
              "reactNativeArchitectures": "armeabi-v7a,arm64-v8a"
            }
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.95811060419-vb1vj5n7smvv8pvg01ae7vcp4jh18atr"
        }
      ],
      "./plugins/withCustomGradleProperties",
      "./plugins/withDisableLint",
      "./plugins/withZoomNetworkSecurity",
      "./plugins/withZoomResourcePatch",
      "./plugins/withAndroidSigningConfig",
      "expo-speech-recognition",
      [
        "react-native-permissions",
        {
          "iosPermissions": ["Notifications"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "googleOAuth": {
        "androidClientId": "95811060419-h1uufrtveqqi0k9huhs80v1tfh8ib54n.apps.googleusercontent.com",
        "iosClientId": "95811060419-vb1vj5n7smvv8pvg01ae7vcp4jh18atr.apps.googleusercontent.com",
        "webClientId": "95811060419-6nhke0t0ahjrso6sm66oameeifqbomhr.apps.googleusercontent.com"
      },
      "eas": {
        "projectId": "05553e96-80d6-450b-bf91-12257346fc94"
      }
    },
    "owner": "gravitones"
  }
}
