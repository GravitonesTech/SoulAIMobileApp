{
  "expo": {
    "name": "Soul AI",
    "slug": "soulai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "soulai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.soulai",
      "infoPlist": {
        "NSCameraUsageDescription": "Soul AI needs access to your camera to join video therapy sessions.",
        "NSMicrophoneUsageDescription": "Soul AI needs access to your microphone to participate in audio therapy sessions."
      }
    },
    "android": {
      "package": "com.anonymous.soulai",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/4.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "googleOAuth": {
        "androidClientId": "629973031661-nekkjnr4ahbt31f6i1ps860n50ork0v0.apps.googleusercontent.com",
        "iosClientId": "REPLACE_ME",
        "webClientId": "629973031661-fqoa9j1g6c8p1suie5op8r7la823jsg9.apps.googleusercontent.com"
      },
      "eas": {
        "projectId": "05553e96-80d6-450b-bf91-12257346fc94"
      }
    },
    "owner": "soulbuster"
  }
}
