{
  "expo": {
    "name": "Soul AI",
    "slug": "soulai",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/adaptive_foreground.png",
    "scheme": "soulai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "buildNumber": "5",
      "supportsTablet": true,
      "bundleIdentifier": "com.soulai.in",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 5,
      "package": "com.soulai.in",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#4698ea",
        "foregroundImage": "./assets/images/adaptive_foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash_screen.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#4698ea"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28,
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.zipow.** { *; }\n-keep class us.zoom.** { *; }\n-keep class com.zoom.** { *; }\n-dontwarn com.zipow.**\n-dontwarn us.zoom.**\n-keep class com.razorpay.** { *; }\n-dontwarn com.razorpay.**\n-dontwarn com.google.zxing.Result\n-dontwarn java.awt.event.ActionListener\n-dontwarn javax.swing.SwingUtilities\n-dontwarn javax.swing.Timer"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.95811060419-vb1vj5n7smvv8pvg01ae7vcp4jh18atr"
        }
      ],
      "./plugins/withCustomGradleProperties",
      "./plugins/withDisableLint",
      "./plugins/withZoomNetworkSecurity",
      "./plugins/withZoomResourcePatch",
      "./plugins/withAndroidSigningConfig",
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "googleOAuth": {
        "androidClientId": "95811060419-e64q0ih6giveo457hkki7na1fmjci178.apps.googleusercontent.com",
        "iosClientId": "95811060419-vb1vj5n7smvv8pvg01ae7vcp4jh18atr.apps.googleusercontent.com",
        "webClientId": "95811060419-6nhke0t0ahjrso6sm66oameeifqbomhr.apps.googleusercontent.com"
      },
      "eas": {
        "projectId": "05553e96-80d6-450b-bf91-12257346fc94"
      }
    },
    "owner": "soulbuster"
  }
}
