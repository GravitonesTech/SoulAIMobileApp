{
  "expo": {
    "name": "Soul AI",
    "slug": "soulai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/adaptive_foreground.png",
    "scheme": "soulai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.soulai",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.anonymous.soulai",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECORD_AUDIO"
      ],
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#4698ea",
        "foregroundImage": "./assets/images/adaptive_foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash_screen.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#4698ea"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "./plugins/withCustomGradleProperties",
      "./plugins/withZoomNetworkSecurity",
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "googleOAuth": {
        "androidClientId": "629973031661-nekkjnr4ahbt31f6i1ps860n50ork0v0.apps.googleusercontent.com",
        "iosClientId": "REPLACE_ME",
        "webClientId": "629973031661-fqoa9j1g6c8p1suie5op8r7la823jsg9.apps.googleusercontent.com"
      },
      "eas": {
        "projectId": "05553e96-80d6-450b-bf91-12257346fc94"
      }
    },
    "owner": "soulbuster"
  }
}
